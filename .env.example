# ================================================================
# FLORES DELTA — Variables de Entorno
# ================================================================
# Copiar a .env para desarrollo local o Docker Compose
#   cp .env.example .env
#
# Para levantar todo con Docker:
#   docker compose up -d
#   docker compose --profile minio up -d   (con almacenamiento de archivos)
# ================================================================

# ================================
# POSTGRESQL
# ================================
DB_NAME=flores_delta_db
DB_USERNAME=flores_user
DB_PASSWORD=changeme_in_production

# ================================
# JWT
# ================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=86400000

# ================================
# MINIO (Object Storage para fotos/media)
# Necesario si SPRING_PROFILES_ACTIVE=prod o =minio
# ================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=flores-delta-media

# ================================
# SPRING BOOT
# ================================
# prod  → Activa MinIO (requiere MinIO corriendo)
# minio → Idem prod
# gcs   → Google Cloud Storage (requiere config adicional)
SPRING_PROFILES_ACTIVE=prod

# ================================
# FRONTEND — SÓLO PARA DOCKER COMPOSE
# ================================
# URL del backend desde el browser (se inyecta en build time de Vite).
# En Docker Compose con puerto mapeado: http://localhost:8080
# En desarrollo local: http://localhost:8080 (default)
# En producción: https://api.tudominio.com
# VITE_BACKEND_URL=http://localhost:8080
